# Copy to .env.local. On Cloudflare, add the same values under Workers & Pages → dream-mist → Settings → Build → Variables and secrets (NEXT_PUBLIC_ values are baked in at build time).
# Find both in Supabase → Project Settings → API (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…). Older projects call it the "anon" key, which works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
